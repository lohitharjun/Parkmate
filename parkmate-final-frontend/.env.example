# Demo mode is the default. This does not create real accounts or bookings.
VITE_APP_MODE=demo

# To opt into live mode, set VITE_APP_MODE=live and configure all three values below.
# Use only the Supabase anon/public key in a browser app. Never use a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Origin of the existing Node/Express backend, e.g. https://api.example.com (no /api suffix).
# The frontend adds only paths documented in backend/docs/api-contract.md.
VITE_API_BASE_URL=
