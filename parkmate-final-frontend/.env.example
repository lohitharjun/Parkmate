# Demo mode is the default for now: local sample data, no real accounts or bookings.
# To use real Supabase accounts and the ParkMate backend, set VITE_APP_MODE=live and fill in all three values below.
VITE_APP_MODE=demo
# Use only the Supabase anon/public key in a browser app. Never use a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Origin of the existing Node/Express backend, e.g. https://api.example.com (no /api suffix).
# The frontend adds only paths documented in backend/docs/api-contract.md.
VITE_API_BASE_URL=

# --- Optional services (all are PUBLIC, write-only keys that are meant to be in a browser) ---
# Error tracking (Sentry): paste the project DSN. Leave empty to turn it off.
VITE_SENTRY_DSN=
# Usage analytics (PostHog): paste the project API key (starts with phc_). Only runs after the person accepts.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Shown on the Privacy Policy and Terms pages so people can reach you.
VITE_SUPPORT_EMAIL=

# Never put a Supabase service-role key, Stripe secret key, or any other private key in a VITE_ variable.
# `pnpm check:secrets` (also run during `pnpm build`) fails the build if one slips in.
