# Placeholders only. Copy to .env (never commit .env).
PORT=5000
# Supabase -> Connect -> Session pooler URI (IPv4-friendly; NOT the db.<ref>.supabase.co direct host)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
# Allowed browser origins, comma-separated. "*.vercel.app" allows Vercel preview URLs. Empty = allow all (dev only).
CORS_ORIGINS=http://localhost:5173,https://YOUR_APP.vercel.app
# Set to false only for a local non-SSL Postgres
DB_SSL=true

# ---- only needed for `npm run test:api` (use a DEV project, throwaway users) ----
API_URL=http://localhost:5000
TEST_PASSWORD=YOUR_TEST_USER_PASSWORD
TEST_OWNER_EMAIL=owner@parkmate.test
TEST_CONSUMER_EMAIL=consumer@parkmate.test
TEST_ADMIN_EMAIL=admin@parkmate.test
# local testing only, so npm run test:api is not blocked by the limiter
RATE_LIMIT_GENERAL=5000
RATE_LIMIT_WRITE=1000
# server only: photo upload / signed URLs / account deletion. Never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# optional, error tracking (leave empty to disable)
SENTRY_DSN=
# optional photo settings (defaults shown)
# PHOTO_BUCKET=listing-photos
# PHOTO_URL_TTL_SECONDS=3600
# MAX_PHOTO_BYTES=5242880

# ---- account deletion (migration 010) ----
# days an account waits after "delete my account" before it is erased for good (1-90, default 30). Used by the web service AND the daily purge job.
# DELETION_GRACE_DAYS=30
# how recent the login must be to delete an account, in seconds (default 300). 0 = do not check (only for local testing).
# REAUTH_WINDOW_SECONDS=300
