{
  "name": "parkmate-backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test:unit": "node --test tests/validate.test.js",
    "test:db": "node scripts/run-db-tests.js",
    "test:api": "node scripts/run-api-tests.js",
    "test:health": "node scripts/health-evidence.js",
    "scan:secrets": "node scripts/secret-scan.js",
    "test:api:raw": "node --test tests/api.test.js",
    "pack": "git archive --format=zip --output=parkmate-backend.zip HEAD"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
